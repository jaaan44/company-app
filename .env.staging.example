# Phase 24 — Staging Deployment.
#
# Compose-substitution values ONLY — read by `docker compose` itself
# (via `--env-file .env.staging` or an implicit `.env` at the directory
# `docker compose` is invoked from) to fill the `${DB_*}` placeholders
# in docker-compose.staging.yml's `mysql` service. This is NOT Laravel's
# own .env — that is a separate file, apps/api/.env (see
# apps/api/.env.staging.example), bind-mounted into the `app` container.
#
# Copy this file to `.env.staging` on the staging host (repository
# root, next to docker-compose.staging.yml) and fill in real, generated
# values. NEVER commit the real file — it is already covered by
# .gitignore's/`.dockerignore`'s secret-file patterns; double-check
# before any `git add`.
#
# The four values below MUST exactly match the same-named values inside
# apps/api/.env (Laravel's own copy) — MySQL is provisioned once, from
# this file, at first container start; changing DB_PASSWORD here later
# does not change the already-created MySQL user's password.

DB_DATABASE=company_app_staging
DB_USERNAME=company_app_staging
DB_PASSWORD=REPLACE_WITH_A_GENERATED_HIGH_ENTROPY_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_GENERATED_HIGH_ENTROPY_PASSWORD
