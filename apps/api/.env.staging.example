# Phase 24 — Staging Deployment environment template.
#
# Copy to `apps/api/.env` ON THE STAGING HOST ONLY (never commit the
# real file — apps/api/.gitignore's `.env.*` wildcard, Phase 22/F-05,
# already protects against an accidental commit of a file with this
# exact name). Bind-mounted read-only into the `app` container by
# docker-compose.staging.yml — this file is never baked into the
# staging image itself (see docker/php/Dockerfile.staging).
#
# Every REPLACE_WITH_* placeholder below must be filled with a real,
# generated value before first deploy — never copied from a developer's
# local .env/.env.docker, and never the values shown in this example.
#
# Differs from apps/api/.env.example (local dev) only where staging
# genuinely needs to — see docs/phases/V1_PHASE_24_STAGING_DEPLOYMENT_PLAN.md
# §8 for the full rationale behind each changed value.

APP_NAME="Company App (Staging)"
APP_ENV=staging
APP_KEY=
# Non-negotiable — Phase 22/F-08's own reminder. A debug page on a
# reachable staging host leaks stack traces/config to anyone who can
# trigger a 500. The code default is already `false` if unset; setting
# it explicitly here is a deliberate safeguard against ever copying a
# dev .env verbatim.
APP_DEBUG=false
# No domain/TLS certificate has been decided yet (see the Phase 24
# planning document's TLS/Domain section) — this deployment is
# currently reachable only over plain HTTP on the VPS's reserved port
# 8012. Replace with the real value (http:// or https://, matching
# whatever is actually live) once a staging domain/TLS exists; do not
# invent one now.
APP_URL=http://REPLACE_WITH_STAGING_HOST_OR_IP:8012

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Staging logging should be quieter than local dev's `debug` (avoids
# unnecessary log growth/noise) while still capturing real errors —
# "suitable logging" per the Phase 24 authorization, not a functional
# requirement of any module (nothing in this codebase changes behavior
# based on log level).
LOG_LEVEL=info

# Must exactly match the DB_DATABASE/DB_USERNAME/DB_PASSWORD values in
# the repository-root .env.staging (see .env.staging.example there) —
# that file provisions this same MySQL user/database at first container
# start; this file is what Laravel actually connects with.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=company_app_staging
DB_USERNAME=company_app_staging
DB_PASSWORD=REPLACE_WITH_THE_SAME_GENERATED_PASSWORD_AS_ROOT_ENV_STAGING

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Deliberately `false` until this deployment actually has HTTPS
# (reserved port 8442, no certificate/domain decided yet — see the
# Phase 24 planning document). A `true` value here would make the
# Admin Backoffice's session cookie HTTPS-only, which would silently
# break Admin login entirely on the current HTTP-only (8012) endpoint.
# Flip this to `true` in the same change that actually enables TLS —
# never before, never left `false` afterward.
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Sanctum (Phase 22/F-02): 30-day bearer-token expiration is the
# already-decided production/staging value (DEC-045) — no staging-
# specific override. Uncomment only if the product owner wants a
# deliberately different staging policy (e.g. shorter, for more
# frequent re-login during testing); do not change the default
# silently.
# SANCTUM_EXPIRATION=43200

# No browser-based client exists (Phase 22/F-06, still true for
# Phase 24) — left at the framework default, matching local dev.
# SANCTUM_STATEFUL_DOMAINS=

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# No module in this codebase sends email yet (02_ARCHITECTURE.md) —
# `log` is a legitimate staging value, not a placeholder standing in
# for a real mail provider. Replace only if a future phase adds actual
# outbound mail and staging needs to exercise it.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="staging@REPLACE_WITH_STAGING_DOMAIN"
MAIL_FROM_NAME="${APP_NAME}"

# Object storage provider for staging remains an open decision
# (02_ARCHITECTURE.md §9) — leave blank (local disk) unless the
# product owner has explicitly provisioned S3-compatible storage.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Unaffected by staging — same conservative V1 allowlist as every
# other environment (config/attachments.php).
ATTACHMENTS_DISK=local
